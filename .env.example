# Copy this file to .env and adjust. .env holds secrets and is never committed.

# Where the web app listens. The container uses host networking,
# so this is an address on your machine.
#   127.0.0.1 = only this computer can open the app (safest)
#   0.0.0.0   = other devices on your network can open it too
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=info

# Ollama on this machine. The container uses host networking, so 127.0.0.1 works.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# How long a model stays in memory after its last use (for example 10m or 1h).
OLLAMA_KEEP_ALIVE=10m
# Embedding model for search. It runs on CPU and stays loaded, so it never takes GPU memory.
OLLAMA_EMBED_MODEL=nomic-embed-text
EMBED_BATCH_SIZE=32

# --- AWS Bedrock ---
AWS_REGION=us-east-1
# Your AWS keys. Leave these commented out to use ~/.aws or another standard AWS source instead.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Only needed for temporary keys:
# AWS_SESSION_TOKEN=

# Nova Lite reads charts and images in PDFs. For Nova 2 Lite use: us.amazon.nova-2-lite-v1:0
BEDROCK_NOVA_LITE_MODEL_ID=amazon.nova-lite-v1:0
# ARN of your Qwen2.5-VL imported with Bedrock Custom Model Import, for example
# arn:aws:bedrock:us-east-1:123456789012:imported-model/abcd1234efgh
# Leave empty to hide "Qwen2.5-VL (AWS)" from the model list.
BEDROCK_QWEN_VL_MODEL_ARN=
# Imported models sleep when idle. Seconds to wait for one to wake up.
BEDROCK_COLD_START_WAIT=300
