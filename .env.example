# Copy this file to .env and adjust. .env holds secrets and is never committed.

# Where the web app listens. The container uses host networking,
# so this is an address on your machine.
#   127.0.0.1 = only this computer can open the app (safest)
#   0.0.0.0   = other devices on your network can open it too
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=info
