# Copy this file to .env and adjust. .env holds secrets and is never committed.

# Where the web app listens. The container uses host networking,
# so this is an address on your machine.
#   127.0.0.1 = only this computer can open the app (safest)
#   0.0.0.0   = other devices on your network can open it too
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=info

# PDF uploads
MAX_UPLOAD_MB=100
# Resolution of page previews in the UI, and of cropped charts sent to the vision model.
PAGE_PREVIEW_DPI=100
FIGURE_DPI=200

# Who reads charts, pictures and scanned pages when a PDF is uploaded (can be chosen per upload):
#   local = Qwen2.5-VL in Ollama on this computer, aws = Nova Lite on Bedrock, none = PDF text only
DEFAULT_EXTRACTOR=local
VISION_LOCAL_MODEL=qwen2.5vl:latest
# Room for one image plus the reply. Larger uses more GPU memory.
VISION_NUM_CTX=8192
# Figures with more than this many million pixels are scaled down before sending.
# Higher reads small labels better but is slower.
VISION_MAX_MEGAPIXELS=1.0
# How many figures to send to AWS at the same time.
VISION_AWS_CONCURRENCY=4

# Answers. The model reads the best search results, trimmed to this many characters.
CHAT_MAX_SOURCES=8
CHAT_MAX_SOURCE_CHARS=12000
# Chart images sent along when the chosen model can read images (0 to turn off).
CHAT_MAX_IMAGES=2
# Context size for a local chat model. Keep it equal to VISION_NUM_CTX to avoid reloading Qwen.
CHAT_NUM_CTX=8192
CHAT_MAX_ANSWER_TOKENS=1024

# Ollama on this machine. The container uses host networking, so 127.0.0.1 works.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# How long a model stays in memory after its last use (for example 10m or 1h).
OLLAMA_KEEP_ALIVE=10m

# Search model (nomic-embed-text v1.5). It is built into the app and runs on the CPU.
# CPU threads it may use; 0 means up to 4.
EMBED_THREADS=0

# --- AWS Bedrock ---
AWS_REGION=us-east-1
# Your AWS keys. Leave these commented out to use ~/.aws or another standard AWS source instead.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Only needed for temporary keys:
# AWS_SESSION_TOKEN=

# Nova Lite reads charts and images in PDFs. For Nova 2 Lite use: us.amazon.nova-2-lite-v1:0
BEDROCK_NOVA_LITE_MODEL_ID=amazon.nova-lite-v1:0
# ARN of your Qwen2.5-VL imported with Bedrock Custom Model Import, for example
# arn:aws:bedrock:us-east-1:123456789012:imported-model/abcd1234efgh
# Leave empty to hide "Qwen2.5-VL (AWS)" from the model list.
BEDROCK_QWEN_VL_MODEL_ARN=
# Imported models sleep when idle. Seconds to wait for one to wake up.
BEDROCK_COLD_START_WAIT=300
